{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["apps/web/.next/**", "!apps/web/.next/cache/**", ".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "ANTHROPIC_API_KEY",
        "ELEVENLABS_API_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "PAYPAL_CLIENT_ID",
        "PAYPAL_CLIENT_SECRET",
        "PAYPAL_ENV",
        "NEXT_PUBLIC_STRIPE_PLUS_MONTHLY",
        "NEXT_PUBLIC_STRIPE_PLUS_YEARLY",
        "NEXT_PUBLIC_STRIPE_PRO_MONTHLY",
        "NEXT_PUBLIC_STRIPE_PRO_YEARLY",
        "NEXT_PUBLIC_BASE_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    }
  }
}
